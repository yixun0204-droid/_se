{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hw3-safe-search",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.css"],
      "fallthrough": false
    }
  ],
  "observability": {
    "enabled": true
  }
}
